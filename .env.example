# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# --- Postgres ---
DB_USER=secure_dms
DB_PASSWORD=changeme_dev_only
DB_NAME=secure_dms_dev
DB_PORT=5432
DATABASE_URL=postgresql://secure_dms:changeme_dev_only@localhost:5432/secure_dms_dev

# --- API ---
NODE_ENV=development
PORT=4000
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# --- Auth / Crypto (placeholders — rotate before any real deployment) ---
JWT_ACCESS_SECRET=replace_me_access_secret
JWT_REFRESH_SECRET=replace_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
ENCRYPTION_MASTER_KEY=replace_me_64_char_hex_master_key

# --- Storage (local filesystem folder — the API encrypts bytes with
# AES-256-GCM before they ever reach this adapter; see services/crypto) ---
STORAGE_ROOT_PATH=./apps/api/storage-data

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Body limits ---
BODY_LIMIT=5mb

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# --- Auth / RBAC (Sprint 1) ---
AUTH_LOCKOUT_THRESHOLD=5
INVITATION_TTL=7d
APP_BASE_URL=http://localhost:3000

# --- MFA (TOTP) ---
MFA_ISSUER="Secure DMS"

# --- Mail / SMTP (MailHog in dev — see docker-compose.yml). Leave SMTP_HOST
# empty to run the mail service in disabled/log-only mode (e.g. in CI). ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Secure DMS <no-reply@secure-dms.local>"

# --- Bootstrap admin (REQUIRED — read directly by the seed migration, must
# be set in whatever shell/container runs `migrate:up`, not just in the API's
# runtime env) ---
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@secure-dms.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe_Bootstrap_123!

# --- Documents (Sprint 3) ---
DOCUMENT_MAX_SIZE_MB=25
DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/tiff,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain
# Fixed identifier for the current single master key — bump this if
# ENCRYPTION_MASTER_KEY is ever rotated, so old versions still record
# which key they were encrypted with.
ENCRYPTION_KEY_ID=master-v1
