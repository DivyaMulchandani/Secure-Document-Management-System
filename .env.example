# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# --- Postgres ---
DB_USER=secure_dms
DB_PASSWORD=changeme_dev_only
DB_NAME=secure_dms_dev
DB_PORT=5432
DATABASE_URL=postgresql://secure_dms:changeme_dev_only@localhost:5432/secure_dms_dev

# --- API ---
NODE_ENV=development
PORT=4000
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# --- Auth / Crypto (placeholders — rotate before any real deployment) ---
JWT_ACCESS_SECRET=replace_me_access_secret
JWT_REFRESH_SECRET=replace_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
ENCRYPTION_MASTER_KEY=replace_me_64_char_hex_master_key

# --- Storage (local encrypted filesystem folder — Sprint 0 has no encryption yet) ---
STORAGE_ROOT_PATH=./apps/api/storage-data

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Body limits ---
BODY_LIMIT=5mb

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
